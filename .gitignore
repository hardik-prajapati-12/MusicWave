# ==========================================
# Dependencies
# ==========================================
node_modules/
jspm_packages/

# ==========================================
# Environment & Secrets (Never commit credentials)
# ==========================================
.env
.env.*
!.env.example
!.env.template

# ==========================================
# Angular & Build Outputs
# ==========================================
.angular/
dist/
tmp/
out-tsc/
bazel-out/
.sass-cache/
.connect.sock

# ==========================================
# User Uploads (Audio & Images)
# ==========================================
backend/uploads/audio/*
!backend/uploads/audio/.gitkeep
backend/uploads/images/*
!backend/uploads/images/.gitkeep
uploads/*
!uploads/.gitkeep

# ==========================================
# Logs & Debugging
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Runtime & Process IDs
# ==========================================
pids
*.pid
*.seed
*.pid.lock

# ==========================================
# Testing & Coverage
# ==========================================
coverage/
*.lcov
.nyc_output/
.cache/

# ==========================================
# IDEs & Code Editors
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

